# Copy to .env and fill in. Never put real keys in this example file.

DATABASE_URL=postgresql://postgres:password@localhost:5432/impactproof

# Cloudinary: console.cloudinary.com > Settings > API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=impactproof

# Gemini: aistudio.google.com > Get API key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

QDRANT_URL=http://localhost:6333
# Only for Qdrant Cloud (cloud.qdrant.io). Leave empty locally.
QDRANT_API_KEY=

# Where the frontend runs. QR codes and verification links point here.
# For a phone demo, set this to your public tunnel URL (see README).
PUBLIC_APP_URL=http://localhost:3000

WEATHER_ENABLED=true
